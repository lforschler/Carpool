# Cloud Postgres (Neon / Supabase) — required for real multi-device persistence
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Local Postgres (this agent uses):
DATABASE_URL="postgresql://carpool:carpool@127.0.0.1:5432/carpool?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
# On Vercel / any hosted HTTPS origin:
# AUTH_TRUST_HOST=true
# AUTH_URL="https://your-app.vercel.app"

# Optional public URL for invite links / production
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# SMS (step c — not used yet)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_MOCK=true
